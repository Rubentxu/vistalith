{
  "name": "vistalith",
  "private": true,
  "packageManager": "pnpm@12.3.3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check apps packages",
    "lint:fix": "biome check --write apps packages",
    "desktop:dev": "pnpm --filter desktop tauri dev",
    "desktop:build": "source scripts/tauri-env.sh && pnpm --filter desktop tauri build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12"
  }
}
